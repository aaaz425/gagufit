{
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm turbo run:*)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(supabase status:*)",
      "Bash(supabase start)",
      "Bash(supabase db reset)"
    ],
    "ask": [
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(supabase db reset --db-url:*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" fetch -q origin main:main 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
